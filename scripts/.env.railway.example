# Railway 部署环境变量模板
# 
# 使用方法:
#   1. 复制此文件为 .env.railway
#   2. 根据实际情况修改变量值
#   3. 在 Railway 控制面板中配置这些环境变量
#   4. 不要将此文件提交到 Git（已在 .gitignore 中）

# ============================================================
# 必需的环境变量
# ============================================================

# 运行环境
NODE_ENV=production

# JWT 签名密钥 (至少 32 字符)
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-generated-jwt-secret-here

# 应用监听端口
PORT=3000

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info

# ============================================================
# 数据库配置
# ============================================================

# MySQL 连接字符串
# 格式: mysql://username:password@host:port/database
# 由 Railway MySQL 自动提供，无需手动配置
# 示例: mysql://root:password@mysql.railway.internal:3306/railway
DATABASE_URL=mysql://root:password@mysql.railway.internal:3306/railway

# ============================================================
# 可选的环境变量
# ============================================================

# 文件存储路径
STORAGE_PATH=.storage/documents

# 应用标题
VITE_APP_TITLE=文档相似度分析系统

# ============================================================
# 说明
# ============================================================
#
# 1. JWT_SECRET
#    - 用于签名 JWT 令牌
#    - 必须是随机字符串，至少 32 字符
#    - 不要在多个环境间共享
#    - 生成方法见上面的注释
#
# 2. DATABASE_URL
#    - 由 Railway MySQL 服务自动生成
#    - 无需手动配置
#    - 在 Railway 控制面板中会自动显示
#
# 3. PORT
#    - Railway 会通过环境变量提供端口号
#    - 应用应该使用 process.env.PORT
#    - 默认值为 3000
#
# 4. LOG_LEVEL
#    - debug: 详细的调试信息
#    - info: 一般信息
#    - warn: 警告信息
#    - error: 错误信息
#
# ============================================================
